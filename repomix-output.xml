    hikari:
      maximum-pool-size: 10
      minimum-idle: 2
      connection-timeout: 20000

  # --- CẤU HÌNH HIBERNATE / JPA ---
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: none
    show-sql: true
    properties:
      hibernate:
        format_sql: true
